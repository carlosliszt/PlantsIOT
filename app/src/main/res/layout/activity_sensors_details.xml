<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensores ambientais"
            android:textColor="@color/green_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Acompanhe as condições atuais da sua planta"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="20dp"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/SensorRow">
                    <ImageView
                        style="@style/SensorIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_temperature" />
                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp" />
                    <ImageButton
                        android:id="@+id/btnTemperatureHelp"
                        style="@style/HelpIconButton"
                        android:contentDescription="Ajuda sobre temperatura"
                        android:tooltipText="O que é temperatura?" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SensorRow">
                    <ImageView
                        style="@style/SensorIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_air_humidity" />
                    <TextView
                        android:id="@+id/tvAirHumidity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp" />
                    <ImageButton
                        android:id="@+id/btnAirHumidityHelp"
                        style="@style/HelpIconButton"
                        android:contentDescription="Ajuda sobre umidade do ar"
                        android:tooltipText="O que é umidade do ar?" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SensorRow">
                    <ImageView
                        style="@style/SensorIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_soil_moisture" />
                    <TextView
                        android:id="@+id/tvSoilMoisture"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp" />
                    <ImageButton
                        android:id="@+id/btnSoilMoistureHelp"
                        style="@style/HelpIconButton"
                        android:contentDescription="Ajuda sobre umidade do solo"
                        android:tooltipText="O que é umidade do solo?" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SensorRow">
                    <ImageView
                        style="@style/SensorIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_luminosity" />
                    <TextView
                        android:id="@+id/tvLuminosity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp" />
                    <ImageButton
                        android:id="@+id/btnLuminosityHelp"
                        style="@style/HelpIconButton"
                        android:contentDescription="Ajuda sobre luminosidade"
                        android:tooltipText="O que é luminosidade?" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SensorRow">
                    <ImageView
                        style="@style/SensorIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ph" />
                    <TextView
                        android:id="@+id/tvPh"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp" />
                    <ImageButton
                        android:id="@+id/btnPhHelp"
                        style="@style/HelpIconButton"
                        android:contentDescription="Ajuda sobre pH"
                        android:tooltipText="O que é pH?" />
                </LinearLayout>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Gráfico de temperatura e pH (últimas 10 leituras)"
            android:textColor="@color/green_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardCornerRadius="22dp">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:padding="16dp"/>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Voltar"
            app:backgroundTint="@color/green_soft" />
    </LinearLayout>
</ScrollView>
